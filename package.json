{
  "name": "muwanshots",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "create-admin": "node scripts/create-admin.mjs",
    "db:create": "wrangler d1 create muwanshots-db",
    "db:migrate": "wrangler d1 execute muwanshots-db --local --file=./migrations/0001_initial.sql && wrangler d1 execute muwanshots-db --local --file=./migrations/0002_seed.sql",
    "db:migrate:remote": "wrangler d1 execute muwanshots-db --remote --file=./migrations/0001_initial.sql && wrangler d1 execute muwanshots-db --remote --file=./migrations/0002_seed.sql",
    "r2:create": "wrangler r2 bucket create muwanshots-media"
  },
  "dependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "bcryptjs": "^3.0.3",
    "blurhash": "^2.0.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "wrangler": "^4.127.1"
  }
}
